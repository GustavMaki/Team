@using System.Text.Json
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Tharga.Toolkit
@typeparam TMember where TMember : class, Tharga.Team.ITeamMember
@inject ITeamDirectoryService TeamDirectoryService
@inject ITeamOversightService TeamOversightService
@inject IServiceProvider ServiceProvider
@inject ILocalStorageService LocalStorage

@* Current-user row highlight. Applied to the cells (not the <tr>) so Radzen's own cell backgrounds
   don't paint over it. The translucent blue composites correctly on both light and dark themes;
   colour-mix keeps the left accent visible against either. *@
<style>
    tr[data-tharga-current-member] > td {
        background-color: rgba(37, 99, 235, 0.16) !important;
    }

    tr[data-tharga-current-member] > td:first-child {
        box-shadow: inset 3px 0 0 0 var(--rz-primary, #2563eb);
    }

    /* The selected team, marking what ExpandableCard.Selected used to. A left accent only: the current
       member row already owns the tint, and two competing backgrounds in one view read as an error
       rather than as two facts. Cell-level for the same reason as above -- a background on the row
       element is painted over by Radzen's own cell backgrounds.
       (Angle brackets are avoided even in this comment: Razor parses them inside a style block.) */
    tr[data-tharga-selected-team] > td:first-child {
        box-shadow: inset 3px 0 0 0 var(--rz-primary, #2563eb);
    }

    tr[data-tharga-selected-team] > td {
        font-weight: 600;
    }
</style>

@if (_teams == null)
{
    <Loading />
}
else
{
    <RadzenStack Gap="1rem">
        <TeamInviteView TMember="TMember" />
        @if (TeamAccessFilter.ShowToggle(_teams, MyAccessLevel))
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenSwitch Value="@_hideNoAccess" ValueChanged="@((bool hide) => SetHideNoAccessAsync(hide))" Name="hideNoAccessTeams" />
                <RadzenLabel Text="@_text[TeamComponentText.HideNoAccessTeams]" Component="hideNoAccessTeams" />
            </RadzenStack>
        }
        @if (ShowAllTeamsSwitch && TeamSelectionFilter.ShowToggle(_accessShown, ShowSelectedTeamOnly, _ctx.SelectedTeam?.Key, t => t.Key))
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenSwitch Value="@_showAllTeams" ValueChanged="@((bool all) => SetShowAllTeams(all))" Name="showAllTeams" />
                <RadzenLabel Text="@_text[TeamComponentText.ShowAllTeams]" Component="showAllTeams" />
            </RadzenStack>
        }
        @if (_teams.Any())
        {
            @* Two shapes for two situations, chosen by the same threshold the selector uses.

               Cards suit a handful: the expand affordance is obvious and a grid of three rows looks like
               an administrative report of nothing much. Past the threshold that reverses -- cards cannot
               be sorted, filtered or paged, and a page of stacked accordions is not a list.

               Both render @TeamDetail and @TeamActionsFragment, defined once below, and both are made of the same
               components (TeamMembersView, TeamActionsMenu, TeamConsentControl). That is what keeps two
               layouts from being twice the work: only the container differs, never the contents, so a
               change to a member column or an action cannot land in one shape and not the other.

               Paging is a *rendering* fix, not a loading one: ReloadTeams still fetches every team with
               its members. A paged, member-less read is a service-contract change and is out of scope. *@
            @if (TeamListPresentation.ShowAsGrid(_layoutCount, TeamFilterThreshold, TeamLayout))
            {
                <RadzenDataGrid @ref="_teamGrid" Data="@_shownTeams" TItem="ITeam<TMember>"
                                AllowSorting="@AllowTeamSorting"
                                AllowFiltering="@TeamSelectorGate.ShowFilter(_layoutCount, TeamFilterThreshold, AllowTeamFiltering)"
                                AllowPaging="@TeamSelectorGate.ShowFilter(_layoutCount, TeamPageSize + 1, AllowTeamPaging)"
                                FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                PageSize="@TeamPageSize" PageSizeOptions="@TeamPageSizeOptionsValues" PageSizeText="@_text[TeamComponentText.PageSize]"
                                ShowPagingSummary="true" PagingSummaryFormat="@_text[TeamComponentText.PagingSummary]"
                                ExpandMode="DataGridExpandMode.Multiple"
                                RowRender="@OnTeamRowRender">
                    <Columns>
                        @* Name is a real property on ITeam, so it sorts and filters through the grid's
                           own machinery. Every other column here is derived -- the caller's level comes
                           from their membership row, the badges from consent -- so they are marked
                           unsortable rather than given a SortProperty that does not exist. A sort control
                           that silently does nothing is worse than no control. *@
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="@_text[TeamComponentText.ColumnTeam]" Property="Name"
                                              SortOrder="SortOrder.Ascending" Filterable="true">
                            <Template Context="team">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <TeamAvatar Team="@team" Size="24px" />
                                    <span>@team.Name</span>
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="@_text[TeamComponentText.ColumnYourAccess]" Width="170px" Filterable="false" Sortable="false">
                            <Template Context="team">
                                @YourAccessCell(team)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="@_text[TeamComponentText.ColumnConsent]" Width="230px" Filterable="false" Sortable="false"
                                              Visible="@(_ctx.CanSeeConsent || _ctx.ShowConsentToggle)">
                            <Template Context="team">
                                @* No label: the column header already says Consent, and repeating it in
                                   every cell is the same word printed once per row. *@
                                @ConsentCell(team)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="@_text[TeamComponentText.ColumnMembers]" Width="110px" Filterable="false" Sortable="false">
                            <Template Context="team">
                                @{
                                    var counts = TeamMemberCounts.Of(team.Members);
                                }
                                <span title="@counts.Title">@counts.Text</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="" Width="240px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                            <Template Context="team">
                                @TeamActionsFragment(team)
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <Template Context="team">
                        @TeamDetail(team)
                    </Template>
                </RadzenDataGrid>
            }
            else
            {
                @foreach (var team in _shownTeams)
                {
                    <ExpandableCard Text="@team.Name" Icon="groups" ImageUrl="@TeamIconUrl(team)" Selected="@(_ctx.SelectedTeam?.Key == team.Key)">
                        @* Membership only. Consent stays out of the title: a bare "No access" there read as
                           the caller's own access rather than as a setting, so it lives under its label in
                           the card body. Badges only: TopMenu sits inside the header's click handler. *@
                        <TopMenu>
                            @MembershipBadge(team)
                        </TopMenu>
                        <ChildContent>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.End" Gap="0.75rem">
                                @ConsentControl(team, showLabel: true)
                                @TeamActionsFragment(team)
                            </RadzenStack>
                            @TeamDetail(team)
                        </ChildContent>
                    </ExpandableCard>
                }
            }
        }
        <RadzenText Visible="@(!_teams.Any() && _ctx.AllowTeamCreation)">@_text[TeamComponentText.NoTeamsCanCreate]</RadzenText>
        <RadzenText Visible="@(!_teams.Any() && !_ctx.AllowTeamCreation)">@_text[TeamComponentText.NoTeams]</RadzenText>
        @if (_ctx.AllowTeamCreation)
        {
            <RadzenStack Orientation="Orientation.Horizontal">
                <CreateTeamButton CreateTeamRequested="@CreateTeamRequested" Created="@ReloadTeams" />
            </RadzenStack>
        }

    </RadzenStack>
}

@code {
    /// <summary>
    /// When true, callers with the <c>team:manage</c> scope can inline-edit a member's display name
    /// (Member.Name) via a pencil icon. When false (default), the Name column is read-only — preserves
    /// the existing behavior for consumers that haven't opted in.
    /// </summary>
    [Parameter] public bool EnableMemberNameEdit { get; set; }

    /// <summary>
    /// Optional callback invoked after a successful inline edit of <see cref="ITeamMember.Name"/>.
    /// Use to refresh derived caches, log additional context, etc.
    /// Tharga.Team handles the persistence itself; this is purely observational.
    /// </summary>
    [Parameter] public EventCallback<MemberNameChangedArgs> OnMemberNameChanged { get; set; }

    /// <summary>When true (and an <see cref="IScopeRegistry"/> is registered), shows the per-member effective-scope (i) tooltip. Default true.</summary>
    [Parameter] public bool ShowScopeTooltip { get; set; } = true;

    /// <summary>When true (and an <see cref="IScopeRegistry"/> is registered), shows the per-member scope-override editor column. Default false.</summary>
    [Parameter] public bool ShowScopeOverrides { get; set; }

    /// <summary>When true (and an <see cref="ITenantRoleRegistry"/> is registered), shows the per-member tenant-role editor column. Default false.</summary>
    [Parameter] public bool ShowRoles { get; set; }

    // --- The teams grid. Deliberately prefixed "Team", because every other parameter on this component
    // --- configures the *members* grid inside a row, and a bare "AllowSorting" would be ambiguous.

    /// <summary>
    /// Whether the team list is drawn as cards or as a grid. Defaults to
    /// <see cref="TeamListLayout.Auto"/>: cards while the list is short, a grid once it is not.
    /// </summary>
    [Parameter] public TeamListLayout TeamLayout { get; set; } = TeamListLayout.Auto;

    /// <summary>Sorting on the team list. Default on.</summary>
    [Parameter] public bool AllowTeamSorting { get; set; } = true;

    /// <summary>
    /// Forces the team-name filter on or off. Null, the default, shows it once there are
    /// <see cref="TeamFilterThreshold"/> teams or more.
    /// </summary>
    [Parameter] public bool? AllowTeamFiltering { get; set; }

    /// <summary>
    /// How many teams there must be before the list offers a filter. Defaults to
    /// <see cref="TeamSelectorGate.DefaultFilterThreshold"/> — the same judgement the selector makes,
    /// because it is the same question about the same collection.
    /// </summary>
    [Parameter] public int TeamFilterThreshold { get; set; } = TeamSelectorGate.DefaultFilterThreshold;

    /// <summary>
    /// Forces paging on or off. Null, the default, pages only when there is more than one page —
    /// a pager under a list that fits is a control that does nothing.
    /// </summary>
    [Parameter] public bool? AllowTeamPaging { get; set; }

    /// <summary>Teams per page. Default 10.</summary>
    [Parameter] public int TeamPageSize { get; set; } = 10;

    /// <summary>
    /// Shows only the selected team, with a switch to all the teams the caller can see. Default false, so a host that
    /// does not opt in shows what it always did (Tharga/Team#400).
    /// </summary>
    /// <remarks>
    /// Presentation only: it narrows the list and nothing else. The component still loads every team it did before,
    /// and what the caller may see or do is unchanged. The switch is offered only while there is another team to
    /// switch to, and a caller with no selected team sees every team, since narrowing would leave an empty page.
    /// Set <see cref="ShowAllTeamsSwitch"/> to false to leave the switch out. For a page about the selected team alone,
    /// see <see cref="TeamMembersView{TMember}"/>.
    /// Whether it should become the default is left for a major version.
    /// </remarks>
    [Parameter] public bool ShowSelectedTeamOnly { get; set; }

    /// <summary>
    /// Whether the switch to all the teams the caller can see is offered while <see cref="ShowSelectedTeamOnly"/> narrows
    /// the list. Default true, which is what it always did; false leaves the switch out, so the page stays about the selected team.
    /// </summary>
    [Parameter] public bool ShowAllTeamsSwitch { get; set; } = true;

    /// <summary>Page sizes offered. Defaults to 10 / 25 / 50.</summary>
    [Parameter] public IEnumerable<int> TeamPageSizeOptionsValues { get; set; } = [10, 25, 50];

    /// <summary>
    /// Optional callback invoked when the user activates the built-in "Create new Team" button.
    /// When set, it takes precedence over <see cref="ThargaBlazorOptions.CreateTeamPath"/> and the
    /// built-in create — letting a host launch its own onboarding flow (e.g. a dialog or wizard).
    /// When unset, the button navigates to <c>CreateTeamPath</c> (if configured), otherwise it
    /// performs the built-in <see cref="ITeamLifecycleService.CreateTeamAsync"/>. The button is
    /// <see cref="CreateTeamButton"/>, which a host can also place on its own.
    /// </summary>
    [Parameter] public EventCallback CreateTeamRequested { get; set; }

    /// <summary>
    /// Optional template rendered beside the built-in action control on each member row.
    /// </summary>
    /// <remarks>
    /// The <c>TeamComponent</c> counterpart of <c>TeamsListView.TeamActionsTemplate</c>: use this to place a
    /// control <i>next to</i> the member's action button, and <see cref="MemberActionItems"/> to put one
    /// <i>inside</i> its menu.
    /// </remarks>
    [Parameter] public RenderFragment<TMember> MemberActionsTemplate { get; set; }

    /// <summary>
    /// Optional extra items for each member row's split-button dropdown (supply
    /// <c>RadzenSplitButtonItem</c> components). Clicks arrive via <see cref="MemberActionInvoked"/>.
    /// </summary>
    /// <remarks>
    /// The member-row counterpart of <c>TeamsListView.TeamActionItems</c>. An item whose <c>Value</c>
    /// matches one the component owns is handled as that built-in rather than forwarded — see
    /// <c>MemberActionValues</c> for the five names to avoid.
    /// </remarks>
    [Parameter] public RenderFragment MemberActionItems { get; set; }

    /// <summary>Raised when a consumer-supplied split-button item (<see cref="MemberActionItems"/>) is clicked.</summary>
    [Parameter] public EventCallback<MemberRowAction<TMember>> MemberActionInvoked { get; set; }

    /// <summary>
    /// Optional extra columns appended to the member grid, after the built-in ones and before the action
    /// column. Supply <c>RadzenDataGridColumn</c> components.
    /// </summary>
    /// <remarks>
    /// Raw columns rather than a per-row template, so an added column carries its own header, width and
    /// sorting — a host binding a member to something of its own needs a named column, not an unlabelled
    /// cell. Appended before the actions so a new column does not push them into the middle of the row.
    /// </remarks>
    [Parameter] public RenderFragment MemberColumns { get; set; }

    /// <summary>
    /// Show a per-member action opening the audit log for that member, scoped to this team. Off by
    /// default — the log is only queryable when audit storage is configured, and the action is hidden
    /// regardless for callers without <c>audit:read</c>.
    /// </summary>
    [Parameter] public bool ShowAuditLogButton { get; set; }

    private ITeam<TMember>[] _teams;
    private ITeam<TMember>[] _shownTeams = [];
    private ITeam<TMember>[] _accessShown = [];
    private int _layoutCount;
    private bool _hideNoAccess;
    private bool _showAllTeams;

    private TeamViewContext _ctx;

    /// <summary>The texts, once what the components share is read; the English defaults before.</summary>
    private TextSet _text => _ctx?.Text ?? TextSet.Empty;

    private RadzenDataGrid<ITeam<TMember>> _teamGrid;

    /// <summary>
    /// Whether the selected team's row has been opened for the current set of teams.
    /// </summary>
    /// <remarks>
    /// Latched so the row is expanded once and then left alone. Without it, every re-render would
    /// re-open a row the reader had just collapsed — the grid would refuse to stay shut, which reads as
    /// a broken control rather than as a helpful default. Cleared by <see cref="ReloadTeams"/>, so a
    /// changed selection or a reloaded list opens the right row again.
    /// </remarks>
    private bool _selectedRowExpanded;

    /// <summary>
    /// Opens the selected team's row, so the surface a caller is actually working in is the one already
    /// showing.
    /// </summary>
    /// <remarks>
    /// Done here rather than at load because the grid has to exist before a row can be expanded —
    /// <c>_teamGrid</c> is null until the first render that draws it, and in the cards layout it stays
    /// null for good.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender) await RestoreHideNoAccessAsync();

        if (_selectedRowExpanded || _teamGrid == null || _teams == null || _ctx?.SelectedTeam == null) return;

        var row = _shownTeams.FirstOrDefault(x => x.Key == _ctx.SelectedTeam.Key);
        if (row == null) return;

        _selectedRowExpanded = true;
        await _teamGrid.ExpandRow(row);
    }

    protected override async Task OnInitializedAsync()
    {
        _ctx = await TeamViewContext.LoadAsync(ServiceProvider);

        await ReloadTeams();

        await base.OnInitializedAsync();
    }

    private AccessLevel? MyAccessLevel(ITeam<TMember> team) => _ctx.MyAccessLevel(team);

    /// <summary>
    /// The team's members, with the pending access requests above them: the body of a card, and the detail row of a grid.
    /// </summary>
    /// <remarks>
    /// <see cref="TeamMembersView{TMember}"/>, which a host can also use for one team on a page of its own. Rendered by both
    /// layouts and given what the list already read, so a page of several teams reads the caller and the users once.
    /// </remarks>
    private RenderFragment<ITeam<TMember>> TeamDetail => team =>
    @<TeamMembersView TMember="TMember" Team="@team" ViewContext="@_ctx" ShowHeader="false" Changed="@ReloadTeams"
                      EnableMemberNameEdit="@EnableMemberNameEdit" OnMemberNameChanged="@OnMemberNameChanged"
                      ShowScopeTooltip="@ShowScopeTooltip" ShowScopeOverrides="@ShowScopeOverrides" ShowRoles="@ShowRoles"
                      ShowAuditLogButton="@ShowAuditLogButton"
                      MemberActionsTemplate="@MemberActionsTemplate" MemberActionItems="@MemberActionItems"
                      MemberActionInvoked="@MemberActionInvoked" MemberColumns="@MemberColumns" />;

    /// <summary>The team-level actions, as a button or a split button. Shared by both layouts.</summary>
    private RenderFragment<ITeam<TMember>> TeamActionsFragment => team =>
    @<TeamActionsMenu TMember="TMember" Team="@team" ViewContext="@_ctx" Changed="@ReloadTeams" />;

    /// <summary>
    /// The consent selector: editable where consent can be changed, read-only for a caller consent
    /// concerns, and absent for everyone else.
    /// </summary>
    private RenderFragment ConsentControl(ITeam<TMember> team, bool showLabel) =>
    @<TeamConsentControl TMember="TMember" Team="@team" ViewContext="@_ctx" ShowLabel="@showLabel" Changed="@ReloadTeams" />;

    /// <summary>
    /// What this team grants, stated: the grid's Consent cell on rows where consent cannot be changed.
    /// </summary>
    /// <remarks>
    /// The value only. Whether the caller belongs to the team is said in the "Your access" column
    /// (<see cref="YourAccessCell"/>), next to the level it qualifies, rather than here beside a setting.
    /// No label: the column header already says Consent.
    /// </remarks>
    private RenderFragment ConsentBadges(ITeam<TMember> team) =>
    @<text>
        @if (_ctx.CanSeeConsent)
        {
            <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(TeamVisibility.BadgeStyle(_ctx.ConsentOf(team))))"
                         Variant="Variant.Flat"
                         Text="@TeamVisibility.Label(_ctx.ConsentOf(team))"
                         title="@_text[TeamComponentText.ConsentTooltip]" />
        }
    </text>;

    /// <summary>
    /// The grid's "Your access" cell: the level the caller holds, filled when it comes from membership and
    /// outlined when it comes through consent, or "No access" when they hold nothing.
    /// </summary>
    /// <remarks>
    /// No separate not-a-member marker: a non-member either reaches the team through consent, which the
    /// outline already says, or holds nothing, which "No access" already says.
    /// </remarks>
    private RenderFragment YourAccessCell(ITeam<TMember> team) =>
    @<text>
        @{
            var myLevel = MyAccessLevel(team);
            var isMember = _ctx.IsMemberOf(team);
        }
        @if (myLevel != null)
        {
            @* TextSet.Empty renders the English defaults: this component has not been migrated onto
               the text catalogue yet, and is listed as pending in TextCoverage. *@
            <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(AccessLevelBadge.Style(myLevel)))"
                         Variant="@(Enum.Parse<Variant>(AccessLevelBadge.Variant(isMember)))"
                         Text="@AccessLevelBadge.Text(myLevel, TextSet.Empty)"
                         title="@_text[isMember ? TeamComponentText.YourAccessTooltip : TeamComponentText.YourConsentAccessTooltip]" />
        }
        else
        {
            <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(AccessLevelBadge.Style(null)))" Variant="Variant.Flat"
                         Text="@AccessLevelBadge.Text(null, TextSet.Empty)"
                         title="@_text[TeamComponentText.YourAccessTooltip]" />
        }
    </text>;

    /// <summary>"Not a member", for an oversight caller looking at a team they do not belong to.</summary>
    private RenderFragment MembershipBadge(ITeam<TMember> team) =>
    @<text>
        @if (_ctx.CanSeeAllTeams && !_ctx.IsMemberOf(team))
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Variant="Variant.Flat" Text="@_text[TeamComponentText.NotAMember]"
                         title="@_text[TeamComponentText.NotAMemberTooltip]" />
        }
    </text>;

    /// <summary>
    /// The grid's Consent cell: the selector on the row that can be changed, the value stated on the rest.
    /// </summary>
    /// <remarks>
    /// Consent is editable on the selected team alone, so in a list most rows cannot be edited — and a
    /// column of disabled drop-downs is a row of controls that do nothing.
    /// </remarks>
    private RenderFragment ConsentCell(ITeam<TMember> team) =>
    @<text>
        @if (_ctx.ShowConsentToggle && _ctx.CanEditConsent(team))
        {
            @ConsentControl(team, showLabel: false)
        }
        else
        {
            @ConsentBadges(team)
        }
    </text>;

    /// <summary>
    /// Marks the selected team's row, replacing what <c>ExpandableCard.Selected</c> did.
    /// </summary>
    /// <remarks>
    /// Class rather than inline style so a host can restyle it, and so it follows the theme. The member
    /// grid marks the signed-in user's own row the same way, so the two highlights are consistent devices
    /// rather than two inventions.
    /// </remarks>
    private void OnTeamRowRender(RowRenderEventArgs<ITeam<TMember>> args)
    {
        if (_ctx.SelectedTeam?.Key == args.Data?.Key)
        {
            // Marker attribute, styled on the cells -- a background set on the row element is invisible
            // under Radzen's own cell backgrounds. Same device and reason as the current-member row.
            args.Attributes["data-tharga-selected-team"] = "true";
        }
    }

    private string TeamIconUrl(ITeam<TMember> team)
        => string.IsNullOrEmpty(team.Icon) ? null : IconRoute.Url(team.Icon);

    /// <summary>
    /// Reads the remembered switch. After the first render, because browser storage is unreachable while
    /// prerendering; an unreadable store leaves every team showing, the safe default.
    /// </summary>
    private async Task RestoreHideNoAccessAsync()
    {
        try
        {
            if (!await LocalStorage.GetItemAsync<bool>(Constants.HideNoAccessTeamsLocalStorageKey)) return;
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or System.Text.Json.JsonException)
        {
            return;
        }

        await SetHideNoAccessAsync(true, remember: false);
    }

    private async Task SetHideNoAccessAsync(bool hide, bool remember = true)
    {
        _hideNoAccess = hide;
        ApplyTeamFilters();
        _selectedRowExpanded = false;
        StateHasChanged();

        if (!remember) return;
        try
        {
            await LocalStorage.SetItemAsync(Constants.HideNoAccessTeamsLocalStorageKey, hide);
        }
        catch (JSException)
        {
            // Not remembered; the switch still applies for this visit.
        }
    }

    /// <summary>
    /// The two presentation filters in order: the no-access switch first, then the selected-team narrowing. The
    /// layout is chosen from what is left to draw, since a list narrowed to one team is a card, not a grid.
    /// </summary>
    private void ApplyTeamFilters()
    {
        var selectedKey = _ctx.SelectedTeam?.Key;
        _accessShown = TeamAccessFilter.Apply(_teams, _hideNoAccess, MyAccessLevel);
        _shownTeams = TeamSelectionFilter.Apply(_accessShown, ShowSelectedTeamOnly, _showAllTeams, selectedKey, t => t.Key);
        _layoutCount = TeamSelectionFilter.IsNarrowed(_accessShown, ShowSelectedTeamOnly, _showAllTeams, selectedKey, t => t.Key)
            ? _shownTeams.Length
            : _teams.Length;
    }

    private void SetShowAllTeams(bool all)
    {
        _showAllTeams = all;
        ApplyTeamFilters();
        _selectedRowExpanded = false;
        StateHasChanged();
    }

    private async Task ReloadTeams()
    {
        _teams = null;

        // The list is about to change, so the "already opened" latch no longer refers to anything. A
        // reload after selecting a different team should open that team's row.
        _selectedRowExpanded = false;
        await _ctx.RefreshSelectedAsync(ServiceProvider);
        var teams = _ctx.CanSeeAllTeams
            ? await TeamOversightService.GetAllTeamsAsync<TMember>().ToArrayAsync()
            : await TeamDirectoryService.GetTeamsAsync<TMember>().ToArrayAsync();
        _teams = teams.OrderBy(x => x.Name).ToArray();
        ApplyTeamFilters();
        await _ctx.RefreshTeamsAsync(ServiceProvider, _teams);
    }
}
