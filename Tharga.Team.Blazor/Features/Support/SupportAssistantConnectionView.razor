@using Tharga.Team.Blazor.Framework
@using Tharga.Team.Blazor.Features.Team
@inject ISupportAiConnectionService Connections
@inject ITeamStateService TeamState
@inject NotificationService NotificationService

@* What the support assistant answers a team with: the platform's model, the team's own provider, or nothing. The
   service requires assistant:manage on the team, so a reader without it is told rather than shown a form that fails.
   The key is write-only: it is typed, sent, and cleared; nothing here ever reads one back.
   The choice is drawn as cards: each is a button with role="radio" in one radiogroup, so exactly one is checked. *@

<RadzenCard>
    @if (!_ready)
    {
        <Loading />
    }
    else if (_teamKey == null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            @_text[SupportAssistantConnectionViewText.SelectTeam]
        </RadzenAlert>
    }
    else if (!_permitted)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            @_text[SupportAssistantConnectionViewText.NotPermitted]
        </RadzenAlert>
    }
    else
    {
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@_text[SupportAssistantConnectionViewText.Title]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_text[SupportAssistantConnectionViewText.Explanation]</RadzenText>

            @if (_connection.ChangedAt is { } changedAt)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" data-changed>
                    @_text.Format(SupportAssistantConnectionViewText.ChangedBy, _connection.ChangedBy, changedAt.ToLocalTime().ToString("g"))
                </RadzenText>
            }

            <div role="radiogroup" aria-label="@_text[SupportAssistantConnectionViewText.Title]" class="assistant-choice" data-kinds>
                @if (ShowsPlatformFrame)
                {
                    <div class="assistant-frame @(_kind == SupportAiConnectionKind.Platform ? "assistant-frame--on" : null)" data-frame="platform">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@_text[SupportAssistantConnectionViewText.KindPlatform]</RadzenText>
                        @if (_choices.PlatformModels.Length > 0)
                        {
                            <div class="assistant-cards">
                                @foreach (var model in _choices.PlatformModels)
                                {
                                    var on = _kind == SupportAiConnectionKind.Platform && _platformModelId == model.Id;
                                    <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" disabled="@_busy" data-model="@model.Id"
                                            class="assistant-card @(on ? "assistant-card--on" : null)" @onclick="() => ChoosePlatformModel(model.Id)">
                                        <span class="assistant-mark assistant-mark--platform" aria-hidden="true"></span>
                                        <span class="assistant-card__body">
                                            <span class="assistant-card__title">
                                                @model.DisplayName
                                                @if (model.IsDefault)
                                                {
                                                    <span class="assistant-badge" data-default>@_text[SupportAssistantConnectionViewText.ModelDefault]</span>
                                                }
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(model.Provider))
                                            {
                                                <span class="assistant-card__line" data-provider-name>@_text.Format(SupportAssistantConnectionViewText.ModelProvider, model.Provider)</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(model.ProcessedIn))
                                            {
                                                <span class="assistant-card__line" data-processed>@_text.Format(SupportAssistantConnectionViewText.ModelProcessedIn, model.ProcessedIn)</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(model.StoredIn))
                                            {
                                                <span class="assistant-card__line" data-stored>@_text.Format(SupportAssistantConnectionViewText.ModelStoredIn, model.StoredIn)</span>
                                            }
                                        </span>
                                    </button>
                                }
                            </div>
                            @if (ChosenAgreement is { } agreement)
                            {
                                <a href="@agreement" target="_blank" rel="noopener noreferrer" data-agreement>@_text[SupportAssistantConnectionViewText.Agreement]</a>
                            }
                        }
                        else if (_choices.Kinds.Contains(SupportAiConnectionKind.Platform))
                        {
                            @* No catalogue: the platform has the one model its client reports, as before. *@
                            <div class="assistant-cards">
                                <button type="button" role="radio" aria-checked="@(_kind == SupportAiConnectionKind.Platform ? "true" : "false")" disabled="@_busy" data-kind="@SupportAiConnectionKind.Platform"
                                        class="assistant-card @(_kind == SupportAiConnectionKind.Platform ? "assistant-card--on" : null)" @onclick="() => OnKindChanged(SupportAiConnectionKind.Platform)">
                                    <span class="assistant-mark assistant-mark--platform" aria-hidden="true"></span>
                                    <span class="assistant-card__body"><span class="assistant-card__title">@KindLabel(SupportAiConnectionKind.Platform)</span></span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" data-platform-none>
                                @_text[SupportAssistantConnectionViewText.PlatformOffersNone]
                            </RadzenAlert>
                        }
                    </div>
                }

                @if (_choices.Kinds.Any(IsProvider))
                {
                    <div class="assistant-frame @(IsProvider(_kind) ? "assistant-frame--on" : null)" data-frame="own">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@_text[SupportAssistantConnectionViewText.OwnProviderFrame]</RadzenText>
                        <div class="assistant-cards">
                            @foreach (var kind in _choices.Kinds.Where(IsProvider))
                            {
                                var on = _kind == kind;
                                <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" disabled="@_busy" data-kind="@kind"
                                        class="assistant-card @(on ? "assistant-card--on" : null)" @onclick="() => OnKindChanged(kind)">
                                    <span class="assistant-mark assistant-mark--@(SelfHosted(kind) ? "server" : "cloud")" aria-hidden="true"></span>
                                    <span class="assistant-card__body"><span class="assistant-card__title">@KindLabel(kind)</span></span>
                                </button>
                            }
                        </div>

                        @if (IsProvider(_kind))
                        {
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" data-provider="@_kind">
                                @if (SiteOf(_kind) is { } site)
                                {
                                    <a href="@site" target="_blank" rel="noopener noreferrer" data-site>@_text[SupportAssistantConnectionViewText.ProviderSite]</a>
                                }
                                <RadzenFormField Text="@_text[SupportAssistantConnectionViewText.Address]" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="_address" Disabled="_busy" data-address />
                                </RadzenFormField>
                                @* The hint is helper text, not a placeholder: inside a form field the placeholder is the floating label's. *@
                                <RadzenFormField Text="@_text[SupportAssistantConnectionViewText.ApiKey]" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenPassword Value="@ShownKey" ValueChanged="@((string value) => KeyTyped(value))" Disabled="_busy" AutoCompleteType="AutoCompleteType.Off" data-key />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" data-key-hint>
                                            @(KeepsStoredKey ? _text[SupportAssistantConnectionViewText.ApiKeyStored] : _text[RequiresApiKey ? SupportAssistantConnectionViewText.ApiKeyPlaceholder : SupportAssistantConnectionViewText.ApiKeyOptional])
                                        </RadzenText>
                                    </Helper>
                                </RadzenFormField>
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                                    <RadzenButton Text="@_text[SupportAssistantConnectionViewText.LoadModels]" Icon="list" ButtonStyle="ButtonStyle.Light" Click="LoadModelsAsync" Disabled="_busy" data-load-models />
                                    @if (_models.Length > 0)
                                    {
                                        <RadzenFormField Text="@_text[SupportAssistantConnectionViewText.Model]" Variant="Variant.Outlined">
                                            <RadzenDropDown TValue="string" Data="_models" TextProperty="@nameof(SupportAiModel.DisplayName)" ValueProperty="@nameof(SupportAiModel.Id)"
                                                            @bind-Value="_model" Disabled="_busy" Style="min-width: 16rem;" data-models />
                                        </RadzenFormField>
                                    }
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                    <RadzenButton Text="@_text[SupportAssistantConnectionViewText.Test]" Icon="science" ButtonStyle="ButtonStyle.Light" Click="TestAsync" Disabled="@(_busy || _model == null)" data-test />
                                    <RadzenButton Text="@_text[SupportAssistantConnectionViewText.Save]" Icon="save" Click="SaveAsync" Disabled="@(_busy || _model == null)" data-save />
                                    @if (_busy)
                                    {
                                        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Style="width: 20px; height: 20px;" ShowValue="false" data-busy />
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        }
                    </div>
                }

                <button type="button" role="radio" aria-checked="@(_kind == SupportAiConnectionKind.Off ? "true" : "false")" disabled="@_busy" data-kind="@SupportAiConnectionKind.Off"
                        class="assistant-card assistant-card--off @(_kind == SupportAiConnectionKind.Off ? "assistant-card--on" : null)" @onclick="() => OnKindChanged(SupportAiConnectionKind.Off)">
                    <span class="assistant-mark assistant-mark--off" aria-hidden="true"></span>
                    <span class="assistant-card__body"><span class="assistant-card__title">@KindLabel(SupportAiConnectionKind.Off)</span></span>
                </button>
            </div>

            @if (!IsProvider(_kind))
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                    <RadzenButton Text="@_text[SupportAssistantConnectionViewText.Save]" Icon="save" Click="SaveAsync" Disabled="_busy" data-save />
                    @if (_busy)
                    {
                        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Style="width: 20px; height: 20px;" ShowValue="false" data-busy />
                    }
                </RadzenStack>
            }

            @if (_reply != null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" data-reply>
                    @_text[SupportAssistantConnectionViewText.TestReply] @_reply
                </RadzenAlert>
            }
            @if (_problem != null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" data-problem>
                    @_problem
                </RadzenAlert>
            }
        </RadzenStack>
    }
</RadzenCard>

@code {
    [Inject] private IThargaTextProvider TextProvider { get; set; }

    /// <summary>The team whose assistant is shown and changed; the selected team when not set.</summary>
    [Parameter] public string TeamKey { get; set; }

    private TextSet _text = TextSet.Empty;
    private SupportAiConnectionChoices _choices = new();
    private SupportAiConnection _connection = new();
    private SupportAiModel[] _models = [];
    private SupportAiConnectionKind _kind;
    private string _platformModelId;
    private string _address;
    private string _apiKey;
    private string _model;
    private string _reply;
    private string _problem;
    private string _loadedFor;
    private string _teamKey;
    private bool _ready;
    private bool _permitted = true;
    private bool _busy;

    /// <summary>
    /// Shown in the key field while a stored key would be kept, so the field does not look empty. Never sent: no key
    /// holds this character, and it is taken out of whatever is typed.
    /// </summary>
    internal const string StoredKeyMask = "••••••••••••";

    private const char MaskCharacter = '•';

    /// <summary>A stored key is kept only for the provider and address it was entered for, as the service keeps it.</summary>
    private bool KeepsStoredKey => _connection.HasApiKey
                                   && _kind == _connection.Kind
                                   && string.Equals(Trimmed(_address), Trimmed(_connection.BaseAddress), StringComparison.OrdinalIgnoreCase);

    private string ShownKey => _apiKey ?? (KeepsStoredKey ? StoredKeyMask : null);

    /// <summary>Whether the chosen provider needs a key; a server of the team's own may not.</summary>
    private bool RequiresApiKey => _choices.ProviderDefaults.FirstOrDefault(x => x.Kind == _kind)?.RequiresApiKey ?? true;

    /// <summary>
    /// The platform's frame is drawn whenever the host has anything to choose: with no model to offer it says so, rather
    /// than leaving the team to wonder where the platform's option went.
    /// </summary>
    private bool ShowsPlatformFrame => _choices.Kinds.Length > 0;

    /// <summary>The agreement of the chosen platform model, when it is a link a reader can safely follow.</summary>
    private string ChosenAgreement
    {
        get
        {
            var url = _choices.PlatformModels.FirstOrDefault(x => x.Id == _platformModelId)?.AgreementUrl;
            return Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps ? uri.AbsoluteUri : null;
        }
    }

    /// <remarks>What is left once the mask is taken out is the new key; nothing left keeps the stored one.</remarks>
    private void KeyTyped(string value)
    {
        var typed = (value ?? string.Empty).Replace(MaskCharacter.ToString(), string.Empty, StringComparison.Ordinal).Trim();
        _apiKey = typed.Length == 0 ? null : typed;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_ready && _loadedFor == TeamKey) return;

        _loadedFor = TeamKey;
        _ready = false;
        _permitted = true;
        _text = await TextProvider.ResolveAsync(SupportAssistantConnectionViewText.All);
        _teamKey = string.IsNullOrWhiteSpace(TeamKey) ? (TeamState == null ? null : (await TeamState.GetSelectedTeamAsync())?.Key) : TeamKey;

        if (_teamKey != null)
        {
            try
            {
                await LoadAsync();
            }
            catch (UnauthorizedAccessException)
            {
                _permitted = false;
            }
        }

        _ready = true;
    }

    private async Task LoadAsync()
    {
        _choices = await Connections.GetChoicesAsync(_teamKey);
        _connection = await Connections.GetConnectionAsync(_teamKey);

        Select(_choices.Kinds.Contains(_connection.Kind) ? _connection.Kind : _choices.Kinds.FirstOrDefault());
    }

    private void OnKindChanged(SupportAiConnectionKind kind) => Select(kind);

    /// <summary>Choosing a platform model also chooses the platform.</summary>
    private void ChoosePlatformModel(string modelId)
    {
        Select(SupportAiConnectionKind.Platform);
        _platformModelId = modelId;
    }

    /// <summary>Shows a kind as the team has it, or as the provider starts when the team has something else.</summary>
    private void Select(SupportAiConnectionKind kind)
    {
        _kind = kind;
        _apiKey = null;
        _reply = null;
        _problem = null;

        var current = kind == _connection.Kind;
        _address = current && _connection.BaseAddress != null
            ? _connection.BaseAddress
            : _choices.ProviderDefaults.FirstOrDefault(x => x.Kind == kind)?.BaseAddress;
        _model = current ? _connection.Model : null;
        _models = _model == null ? [] : [new SupportAiModel(_model, _model)];

        // The team's own model when it is still offered, otherwise the one a team gets without choosing.
        var offered = _choices.PlatformModels;
        _platformModelId = offered.Any(x => x.Id == _connection.PlatformModelId) && _connection.Kind == SupportAiConnectionKind.Platform
            ? _connection.PlatformModelId
            : (offered.FirstOrDefault(x => x.IsDefault) ?? offered.FirstOrDefault())?.Id;
    }

    private SupportAiProviderRequest Request() => new()
    {
        Kind = _kind,
        BaseAddress = _address,
        ApiKey = string.IsNullOrWhiteSpace(_apiKey) ? null : _apiKey,
        Model = _model
    };

    private Task LoadModelsAsync() => RunAsync(async () =>
    {
        var list = await Connections.ListModelsAsync(_teamKey, Request());
        if (list.Problem != null)
        {
            _problem = list.Problem;
            return;
        }

        _models = list.Models;
        if (_models.All(x => x.Id != _model)) _model = _models.FirstOrDefault()?.Id;
    });

    private Task TestAsync() => RunAsync(async () =>
    {
        var result = await Connections.TestAsync(_teamKey, Request());
        if (result.Succeeded) _reply = result.Reply;
        else _problem = result.Problem;
    });

    private Task SaveAsync() => RunAsync(async () =>
    {
        switch (_kind)
        {
            case SupportAiConnectionKind.Platform:
                if (_choices.PlatformModels.Length > 0 && _platformModelId != null) await Connections.UsePlatformModelAsync(_teamKey, _platformModelId);
                else await Connections.UsePlatformModelAsync(_teamKey);
                break;
            case SupportAiConnectionKind.Off:
                await Connections.TurnOffAsync(_teamKey);
                break;
            default:
                var result = await Connections.ConnectAsync(_teamKey, Request());
                if (!result.Succeeded)
                {
                    _problem = result.Problem;
                    return;
                }
                break;
        }

        _connection = await Connections.GetConnectionAsync(_teamKey);
        Select(_kind);
        NotificationService.Notify(NotificationSeverity.Success, _text[SupportAssistantConnectionViewText.Saved]);
    });

    private async Task RunAsync(Func<Task> operation)
    {
        _busy = true;
        _reply = null;
        _problem = null;
        try
        {
            await operation();
        }
        catch (UnauthorizedAccessException)
        {
            _permitted = false;
        }
        catch (Exception)
        {
            _problem = _text[SupportAssistantConnectionViewText.Failed];
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsProvider(SupportAiConnectionKind kind) => kind is not (SupportAiConnectionKind.Platform or SupportAiConnectionKind.Off);

    /// <summary>A server of the team's own, as against an account at a provider's service.</summary>
    private static bool SelfHosted(SupportAiConnectionKind kind) => kind is SupportAiConnectionKind.Ollama or SupportAiConnectionKind.LlamaCpp;

    /// <summary>Where a reader finds out about, or gets an account at, a provider.</summary>
    private static string SiteOf(SupportAiConnectionKind kind) => kind switch
    {
        SupportAiConnectionKind.Neurolito => "https://neurolito.com",
        SupportAiConnectionKind.Anthropic => "https://www.anthropic.com",
        SupportAiConnectionKind.OpenAI => "https://platform.openai.com",
        SupportAiConnectionKind.Ollama => "https://ollama.com",
        SupportAiConnectionKind.LlamaCpp => "https://github.com/ggml-org/llama.cpp",
        _ => null
    };

    private string KindLabel(SupportAiConnectionKind kind)
        => kind == SupportAiConnectionKind.Platform && _choices.PlatformModel != null
            ? _text.Format(SupportAssistantConnectionViewText.KindPlatformNamed, _choices.PlatformModel)
            : _text[SupportAssistantConnectionViewText.For(kind)];

    private static string Trimmed(string address) => address?.Trim().TrimEnd('/');
}
